{
  "manifest_version": 3,
  "name": "CommitDSA - Sync LeetCode & GFG to GitHub",
  "version": "1.1.0",
  "description": "Automatically sync and backup LeetCode & GeeksforGeeks (GFG) accepted solutions directly to GitHub.",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://practiceapiorigin.geeksforgeeks.org/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": [
        "https://leetcode.com/*",
        "https://*.geeksforgeeks.org/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
